parameters:
	ignoreErrors:
		-
			message: '#^Method Omnistate\\Iana\\Bootstrap\:\:fetch\(\) should return list\<array\{list\<string\>, list\<string\>\}\> but returns list\.$#'
			identifier: return.type
			count: 1
			path: Bootstrap.php

		-
			message: '#^Method Omnistate\\Iana\\Bootstrap\:\:server\(\) has parameter \$urls with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Bootstrap.php

		-
			message: '#^Parameter \#1 \$array of function array_filter expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Bootstrap.php

		-
			message: '#^Parameter \#1 \$string of function rtrim expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Bootstrap.php

		-
			message: '#^Parameter \#2 \$callback of function usort expects callable\(mixed, mixed\)\: int, Closure\(string, string\)\: \(\-1\|0\|1\) given\.$#'
			identifier: argument.type
			count: 1
			path: Bootstrap.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 5
			path: Rdap.php

		-
			message: '#^Cannot access offset ''delegationSigned'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Rdap.php

		-
			message: '#^Cannot access offset 1 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
