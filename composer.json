{
    "name": "omnistate/iana",
    "type": "library",
    "description": "Omnistate IANA: domains, IP addresses and AS numbers through IANA's RDAP bootstrap - the registrar, the dates, the name servers, who holds a network. Free, no key.",
    "keywords": ["rdap", "iana", "whois", "domain", "ip", "asn", "registrar", "omnistate"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omniscient/omnistate": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-intl": "International domain names (idn_to_ascii)"
    },
    "autoload": {"psr-4": {"Omnistate\\Iana\\": ""}, "exclude-from-classmap": ["/Tests/"]},
    "autoload-dev": {"psr-4": {"Omnistate\\Iana\\Tests\\": "Tests/"}},
    "config": {"sort-packages": true}
}
